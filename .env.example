# Kopieer naar .env en vul de waarden in. Zet .env NOOIT in git.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=routeboek
POSTGRES_USER=routeboek
POSTGRES_PASSWORD=vul-hier-een-lang-willekeurig-wachtwoord-in

# --- Applicatie -------------------------------------------------------------
BASE_URL=https://routeboek.unencrypted.nl
CLUB_NAME="Maximus Stampers"
LOG_LEVEL=INFO

# Sleutel voor cookies en tokens. Leeg laten = eenmalig gegenereerd in
# data/secret.key. Zelf invullen kan met: openssl rand -base64 48
SECRET_KEY=

# Op true laten in productie (de reverse proxy doet TLS).
# Alleen op false zetten als je lokaal via http test.
COOKIE_SECURE=true

# --- Beheerder --------------------------------------------------------------
# Dit account krijgt automatisch beheerdersrechten. Bestaat het nog niet, dan
# wordt het aangemaakt met een willekeurig wachtwoord; gebruik daarna
# "wachtwoord vergeten" om er zelf een in te stellen.
ADMIN_EMAIL=r.vloothuis@gmail.com
ADMIN_NAME="Robert Vloothuis"

# --- E-mail (Ziggo) ---------------------------------------------------------
# Poort 587 met STARTTLS werkt; 465 met SMTP_SSL=true kan ook. Poort 25 is dicht.
MAIL_ENABLED=true
SMTP_HOST=smtp.ziggo.nl
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=routeboek@ziggo.nl
SMTP_PASSWORD=vul-hier-het-mailwachtwoord-in
SMTP_FROM=routeboek@ziggo.nl
SMTP_FROM_NAME="Routeboek Maximus Stampers"

# --- Waterpunten ------------------------------------------------------------
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
DEFAULT_RADIUS_M=250
GAP_WARNING_KM=40

# Routes uit data/seed/routes.json importeren bij het starten (idempotent).
SEED_ON_START=true

# --- Container ---------------------------------------------------------------
# De app draait onder deze uid/gid, zodat ./data beschrijfbaar blijft.
# Waarde opvragen met: id -u && id -g
APP_UID=1000
APP_GID=1000
